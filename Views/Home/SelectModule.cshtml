@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Module</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #eaf0f7;
            --fg: #1a2a3a;
            --fg-muted: #5e7a92;
            --accent: #2563eb;
            --accent-hover: #3b82f6;
            --accent-glow: rgba(37, 99, 235, 0.15);
            --radius-lg: 42px;
            --radius: 30px;
            --radius-sm: 18px;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
            padding: 3rem 1.5rem;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 50% at 20% 30%, rgba(37,99,235,0.12), transparent),
                radial-gradient(ellipse 50% 60% at 80% 70%, rgba(56,189,248,0.1), transparent),
                radial-gradient(ellipse 40% 40% at 60% 20%, rgba(99,102,241,0.08), transparent),
                radial-gradient(ellipse 55% 45% at 30% 80%, rgba(14,165,233,0.09), transparent);
            pointer-events: none;
            z-index: 0;
        }

       
        .liquid-glass {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 930px;
            padding: 4.5rem 4.5rem 3.75rem;
            border-radius: var(--radius-lg);

            background:
                linear-gradient(
                    135deg,
                    rgba(255, 255, 255, 0.08) 0%,
                    rgba(255, 255, 255, 0.04) 40%,
                    rgba(255, 255, 255, 0.02) 60%,
                    rgba(255, 255, 255, 0.06) 100%
                );

            backdrop-filter: blur(60px) saturate(1.8) brightness(1.08);
            -webkit-backdrop-filter: blur(60px) saturate(1.8) brightness(1.08);

            border: 1.5px solid rgba(255, 255, 255, 0.45);
            border-top-color: rgba(255, 255, 255, 0.75);
            border-left-color: rgba(255, 255, 255, 0.6);
            border-bottom-color: rgba(255, 255, 255, 0.2);
            border-right-color: rgba(255, 255, 255, 0.28);

            box-shadow:
                0 30px 90px -22px rgba(37, 99, 235, 0.08),
                0 60px 150px -45px rgba(0, 0, 0, 0.06),
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8),
                inset 1.5px 1.5px 0 0 rgba(255, 255, 255, 0.5),
                inset 0 -1.5px 0 0 rgba(0, 0, 0, 0.04),
                inset -1.5px -1.5px 0 0 rgba(0, 0, 0, 0.02),
                inset 0 0 60px -15px rgba(255, 255, 255, 0.15);

            animation: panelIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes panelIn {
            from { opacity: 0; transform: translateY(60px) scale(0.95); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        .liquid-glass::before {
            content: '';
            position: absolute;
            top: -1.5px;
            left: 12%;
            right: 12%;
            height: 3px;
            border-radius: 3px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.95),
                rgba(180, 210, 255, 0.6),
                rgba(255, 255, 255, 0.95),
                transparent
            );
            background-size: 200% 100%;
            animation: shimmer 5s ease-in-out infinite;
        }

        @@keyframes shimmer {
            0%, 100% { background-position: 200% 0; }
            50%      { background-position: -200% 0; }
        }

        .liquid-glass::after {
            content: '';
            position: absolute;
            top: -30%;
            left: -15%;
            width: 130%;
            height: 65%;
            background: radial-gradient(
                ellipse at 30% 50%,
                rgba(255, 255, 255, 0.2),
                rgba(255, 255, 255, 0.05) 40%,
                transparent 70%
            );
            pointer-events: none;
            border-radius: 50%;
        }

        .caustic-bottom {
            position: absolute;
            bottom: -25%;
            right: -10%;
            width: 100%;
            height: 55%;
            background: radial-gradient(
                ellipse at 70% 60%,
                rgba(56, 189, 248, 0.06),
                transparent 60%
            );
            pointer-events: none;
            border-radius: 50%;
            z-index: 0;
        }

        .edge-light {
            position: absolute;
            top: 15%;
            left: -1.5px;
            width: 4.5px;
            height: 40%;
            border-radius: 4.5px;
            background: linear-gradient(
                180deg,
                transparent,
                rgba(255, 255, 255, 0.5) 30%,
                rgba(255, 255, 255, 0.7) 50%,
                rgba(255, 255, 255, 0.5) 70%,
                transparent
            );
            pointer-events: none;
            z-index: 2;
        }

        .edge-light-top {
            position: absolute;
            top: -1.5px;
            left: 20%;
            width: 35%;
            height: 3px;
            border-radius: 3px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.4) 30%,
                rgba(255, 255, 255, 0.6) 50%,
                rgba(255, 255, 255, 0.4) 70%,
                transparent
            );
            pointer-events: none;
            z-index: 2;
        }

       
        .liquid-glass h2 {
            font-size: 2.7rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--fg);
            text-align: center;
            margin-bottom: 0.375rem;
            position: relative;
            z-index: 1;
            animation: textIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
        }

        .panel-subtitle {
            text-align: center;
            color: var(--fg-muted);
            font-size: 1.29rem;
            font-weight: 400;
            margin-bottom: 3.3rem;
            position: relative;
            z-index: 1;
            animation: textIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
        }

        @@keyframes textIn {
            from { opacity: 0; transform: translateY(21px); }
        }


        .modules-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.8rem;
            margin-bottom: 3rem;
            position: relative;
            z-index: 1;
        }

        .module-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.125rem;
            padding: 3rem 1.8rem;
            text-decoration: none;
            color: var(--fg);
            border-radius: var(--radius);

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.1) 0%,
                    rgba(255, 255, 255, 0.03) 50%,
                    rgba(255, 255, 255, 0.07) 100%
                );
            backdrop-filter: blur(24px) saturate(1.5);
            -webkit-backdrop-filter: blur(24px) saturate(1.5);

            border: 1.5px solid rgba(255, 255, 255, 0.35);
            border-top-color: rgba(255, 255, 255, 0.65);
            border-left-color: rgba(255, 255, 255, 0.5);

            box-shadow:
                0 9px 45px -12px rgba(0, 0, 0, 0.05),
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.7),
                inset 1.5px 1.5px 0 0 rgba(255, 255, 255, 0.35),
                inset 0 -1.5px 0 0 rgba(0, 0, 0, 0.03),
                inset 0 0 36px -12px rgba(255, 255, 255, 0.12);

            transition:
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease,
                background 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .module-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -80%;
            width: 55%;
            height: 100%;
            background: linear-gradient(
                105deg,
                transparent,
                rgba(255, 255, 255, 0.35),
                transparent
            );
            transition: left 0.55s ease;
            pointer-events: none;
        }

        .module-card:hover::before {
            left: 130%;
        }

        .module-card:hover {
            transform: translateY(-7.5px) scale(1.01);
            border-color:
                rgba(37, 99, 235, 0.25)
                rgba(37, 99, 235, 0.15)
                rgba(255, 255, 255, 0.3)
                rgba(255, 255, 255, 0.35);
            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.18) 0%,
                    rgba(255, 255, 255, 0.06) 50%,
                    rgba(255, 255, 255, 0.12) 100%
                );
            box-shadow:
                0 24px 75px -15px rgba(37, 99, 235, 0.12),
                0 0 0 4.5px rgba(37, 99, 235, 0.08),
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8),
                inset 1.5px 1.5px 0 0 rgba(255, 255, 255, 0.4),
                inset 0 0 45px -9px rgba(255, 255, 255, 0.18);
        }

        .module-card:active {
            transform: translateY(-3px) scale(0.98);
            transition-duration: 0.1s;
        }

        .module-card:focus-visible {
            outline: 3.75px solid var(--accent);
            outline-offset: 4.5px;
        }

        .module-card:nth-child(1) { animation: cardIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both; }
        .module-card:nth-child(2) { animation: cardIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.36s both; }

        @@keyframes cardIn {
            from { opacity: 0; transform: translateY(30px) scale(0.95); }
        }

        .module-icon {
            font-size: 3.9rem;
            line-height: 1;
            filter: drop-shadow(0 3px 15px rgba(37, 99, 235, 0.12));
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .module-card:hover .module-icon {
            transform: scale(1.15) translateY(-3px);
        }

        .module-label {
            font-size: 1.38rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--fg);
        }

        .module-desc {
            font-size: 1.08rem;
            font-weight: 400;
            color: var(--fg-muted);
            text-align: center;
            line-height: 1.4;
        }

     
        .divider {
            height: 1.5px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.35),
                rgba(148, 180, 210, 0.15),
                rgba(255, 255, 255, 0.35),
                transparent
            );
            margin-bottom: 2.25rem;
            position: relative;
            z-index: 1;
        }

       
        .bottom-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            z-index: 1;
            animation: textIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.44s both;
        }

        .link-ghost {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.23rem;
            font-weight: 600;
            color: var(--fg-muted);
            text-decoration: none;
            padding: 0.75rem 1.5rem;
            border-radius: var(--radius-sm);
            border: 1.5px solid transparent;
            background: transparent;
            transition:
                color 0.2s ease,
                background 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .link-ghost:hover {
            color: var(--accent);
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.35);
            box-shadow:
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.5),
                0 3px 18px -6px rgba(37, 99, 235, 0.1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .link-ghost:active {
            background: rgba(255, 255, 255, 0.3);
        }

        .link-ghost:focus-visible {
            outline: 3.75px solid var(--accent);
            outline-offset: 3px;
        }

        .link-ghost.accent {
            color: var(--accent);
            border-color: rgba(37, 99, 235, 0.15);
            background: rgba(255, 255, 255, 0.1);
        }

        .link-ghost.accent:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(37, 99, 235, 0.25);
            box-shadow:
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.6),
                0 6px 24px -6px rgba(37, 99, 235, 0.12);
        }

        .link-logout {
            color: rgba(160, 55, 55, 0.65);
        }

        .link-logout:hover {
            color: #b53c3c;
            background: rgba(180, 60, 60, 0.06);
            border-color: rgba(180, 60, 60, 0.1);
            box-shadow:
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.3),
                0 3px 18px -6px rgba(180, 60, 60, 0.08);
        }

        .link-logout:active {
            background: rgba(180, 60, 60, 0.1);
        }

        @@media (max-width: 700px) {
            .liquid-glass {
                padding: 3rem 2.5rem 2.5rem;
                border-radius: 32px;
            }
            .liquid-glass h2 {
                font-size: 2.2rem;
            }
            .panel-subtitle {
                font-size: 1.1rem;
                margin-bottom: 2.5rem;
            }
            .modules-grid {
                gap: 1.4rem;
                margin-bottom: 2.5rem;
            }
            .module-card {
                padding: 2.2rem 1.5rem;
            }
            .module-icon {
                font-size: 3rem;
            }
            .module-label {
                font-size: 1.15rem;
            }
            .module-desc {
                font-size: 0.9rem;
            }
            .link-ghost {
                font-size: 1.05rem;
                padding: 0.6rem 1.2rem;
            }
        }

        @@media (max-width: 520px) {
            body {
                padding: 2rem 1rem;
            }
            .liquid-glass {
                padding: 2.25rem 1.5rem 2rem;
                border-radius: 22px;
            }
            .liquid-glass h2 {
                font-size: 1.5rem;
            }
            .panel-subtitle {
                font-size: 0.86rem;
                margin-bottom: 2.2rem;
            }
            .modules-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
                margin-bottom: 2rem;
            }
            .module-card {
                flex-direction: row;
                padding: 1.2rem 1.4rem;
                gap: 1rem;
            }
            .module-icon {
                font-size: 2rem;
            }
            .module-desc {
                display: none;
            }
            .module-label {
                font-size: 0.92rem;
            }
            .bottom-actions {
                flex-direction: column-reverse;
                gap: 0.6rem;
            }
            .link-ghost {
                font-size: 0.82rem;
                padding: 0.5rem 1rem;
            }
            .edge-light, .edge-light-top {
                display: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <div class="liquid-glass">
        <div class="caustic-bottom" aria-hidden="true"></div>
        <div class="edge-light" aria-hidden="true"></div>
        <div class="edge-light-top" aria-hidden="true"></div>

        <h2>Select Module</h2>
        <p class="panel-subtitle">Choose where you want to go</p>

        <div class="modules-grid">
            <a href="/Institute/Index" class="module-card">
                <span class="module-icon" aria-hidden="true">&#127891;</span>
                <span class="module-label">Tuition Institute</span>
                <span class="module-desc">Classes, students & schedules</span>
            </a>
            <a href="/Bookshop/Index" class="module-card">
                <span class="module-icon" aria-hidden="true">&#128218;</span>
                <span class="module-label">Bookshop</span>
                <span class="module-desc">Inventory, sales & orders</span>
            </a>
        </div>

        <div class="divider"></div>

        <div class="bottom-actions">
            <a href="/Account/Logout" class="link-ghost link-logout">Logout</a>
            @if (Context.Session.GetString("Role") == "Owner/Admin")
            {
                <a href="/Account/AddUser" class="link-ghost accent">+ Add User</a>
            }
        </div>
    </div>

</body>
</html>