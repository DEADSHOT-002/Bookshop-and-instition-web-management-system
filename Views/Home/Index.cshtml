    <script>
   
        (function () {
            for (var i = 0; i < 24; i++) {
                var p = document.createElement('div');
                p.classList.add('particle');
                var s = 8 + Math.random() * 20;
                p.style.width = p.style.height = s + 'px';
                p.style.left = Math.random() * 100 + 'vw';
                p.style.animationDuration = (10 + Math.random() * 18) + 's';
                p.style.animationDelay = -(Math.random() * 25) + 's';
                document.body.appendChild(p);
            }
        })();


        var btn = document.getElementById('getStartedBtn');
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var ripple = document.createElement('span');
            ripple.classList.add('ripple');
            var rect = btn.getBoundingClientRect();
            var size = Math.max(rect.width, rect.height);
            ripple.style.width = ripple.style.height = size + 'px';
            ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
            ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
            btn.appendChild(ripple);
            ripple.addEventListener('animationend', function () { ripple.remove(); });
        });


        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var targetUrl = btn.getAttribute('href');
            btn.style.pointerEvents = 'none';
            btn.classList.add('exploding');

            var rect = btn.getBoundingClientRect();
            var cx = rect.left + rect.width / 2;
            var cy = rect.top + rect.height / 2;
            var maxDist = Math.max(
                Math.hypot(cx, cy),
                Math.hypot(window.innerWidth - cx, cy),
                Math.hypot(cx, window.innerHeight - cy),
                Math.hypot(window.innerWidth - cx, window.innerHeight - cy)
            );
            var waveSize = maxDist * 2.2;

            var wave = document.createElement('div');
            wave.classList.add('exit-wave');
            wave.style.width = waveSize + 'px';
            wave.style.height = waveSize + 'px';
            wave.style.left = (cx - waveSize / 2) + 'px';
            wave.style.top = (cy - waveSize / 2) + 'px';
            document.body.appendChild(wave);

            setTimeout(function () {
                document.getElementById('mainOverlay').classList.add('leaving');
            }, 150);

            setTimeout(function () {
                var flash = document.createElement('div');
                flash.classList.add('flash-overlay');
                document.body.appendChild(flash);
            }, 450);

            setTimeout(function () {
                window.location.href = targetUrl;
            }, 850);
        });
    </script>
