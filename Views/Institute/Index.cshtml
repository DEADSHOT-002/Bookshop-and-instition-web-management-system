@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Institute Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #eaf0f7;
            --fg: #1a2a3a;
            --fg-muted: #5e7a92;
            --accent: #2563eb;
            --accent-hover: #3b82f6;
            --accent-glow: rgba(37, 99, 235, 0.15);
            --radius: 30px;
            --radius-sm: 18px;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
            padding: 4rem 1.5rem;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 50% at 20% 30%, rgba(37,99,235,0.12), transparent),
                radial-gradient(ellipse 50% 60% at 80% 70%, rgba(56,189,248,0.1), transparent),
                radial-gradient(ellipse 40% 40% at 60% 20%, rgba(99,102,241,0.08), transparent),
                radial-gradient(ellipse 55% 45% at 30% 80%, rgba(14,165,233,0.09), transparent);
            pointer-events: none;
            z-index: 0;
        }

        .dash-content {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 930px;
        }

        .dash-header {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            margin-bottom: 2.5rem;
            animation: textIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .dash-header-icon {
            font-size: 2.8rem;
            line-height: 1;
            filter: drop-shadow(0 2px 10px rgba(37, 99, 235, 0.15));
        }

        .dash-header h2 {
            font-size: 2.4rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--fg);
        }

        .dash-header-sub {
            font-size: 0.88rem;
            color: var(--fg-muted);
            font-weight: 400;
            margin-top: 0.1rem;
        }

        @@keyframes textIn {
            from { opacity: 0; transform: translateY(21px); }
        }

        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2.8rem;
        }

        .stat-card {
            padding: 1.8rem 1.5rem;
            border-radius: var(--radius);
            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.1) 0%,
                    rgba(255, 255, 255, 0.03) 50%,
                    rgba(255, 255, 255, 0.07) 100%
                );
            backdrop-filter: blur(24px) saturate(1.5);
            -webkit-backdrop-filter: blur(24px) saturate(1.5);

            border: 1.5px solid rgba(255, 255, 255, 0.35);
            border-top-color: rgba(255, 255, 255, 0.65);
            border-left-color: rgba(255, 255, 255, 0.5);

            box-shadow:
                0 9px 45px -12px rgba(0, 0, 0, 0.05),
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.7),
                inset 1.5px 1.5px 0 0 rgba(255, 255, 255, 0.35),
                inset 0 -1.5px 0 0 rgba(0, 0, 0, 0.03),
                inset 0 0 36px -12px rgba(255, 255, 255, 0.12);

            animation: cardIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
        }

        .stat-card:nth-child(1) { animation-delay: 0.18s; }
        .stat-card:nth-child(2) { animation-delay: 0.26s; }

        @@keyframes cardIn {
            from { opacity: 0; transform: translateY(24px) scale(0.96); }
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow:
                0 18px 50px -14px rgba(37, 99, 235, 0.1),
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.8),
                inset 1.5px 1.5px 0 0 rgba(255, 255, 255, 0.4),
                inset 0 0 40px -10px rgba(255, 255, 255, 0.15);
        }

        .stat-icon {
            font-size: 1.8rem;
            margin-bottom: 0.6rem;
            filter: drop-shadow(0 1px 6px rgba(37, 99, 235, 0.1));
        }

        .stat-label {
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--fg-muted);
            margin-bottom: 0.3rem;
        }

        .stat-value {
            font-size: 1.9rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--fg);
        }

        .section-label {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--fg-muted);
            margin-bottom: 1rem;
        }

        .divider {
            height: 1.5px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(148, 180, 210, 0.25),
                rgba(148, 180, 210, 0.1),
                rgba(148, 180, 210, 0.25),
                transparent
            );
            margin-bottom: 2.2rem;
        }

        .divider-sm {
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(148, 180, 210, 0.18),
                rgba(148, 180, 210, 0.08),
                rgba(148, 180, 210, 0.18),
                transparent
            );
            margin: 2rem 0;
        }

        .link-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.2rem;
            margin-bottom: 0.5rem;
        }

        .link-tile {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.4rem 1.6rem;
            text-decoration: none;
            color: var(--fg);
            border-radius: var(--radius-sm);

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.1) 0%,
                    rgba(255, 255, 255, 0.03) 50%,
                    rgba(255, 255, 255, 0.07) 100%
                );
            backdrop-filter: blur(16px) saturate(1.4);
            -webkit-backdrop-filter: blur(16px) saturate(1.4);

            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-top-color: rgba(255, 255, 255, 0.55);
            border-left-color: rgba(255, 255, 255, 0.45);

            box-shadow:
                0 4px 24px -8px rgba(0, 0, 0, 0.03),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.6),
                inset 1px 1px 0 0 rgba(255, 255, 255, 0.3),
                inset 0 -1px 0 0 rgba(0, 0, 0, 0.02),
                inset 0 0 24px -8px rgba(255, 255, 255, 0.1);

            transition:
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s ease,
                border-color 0.25s ease,
                background 0.25s ease;
            position: relative;
            overflow: hidden;
        }

        .link-tile::before {
            content: '';
            position: absolute;
            top: 0;
            left: -80%;
            width: 55%;
            height: 100%;
            background: linear-gradient(
                105deg,
                transparent,
                rgba(255, 255, 255, 0.3),
                transparent
            );
            transition: left 0.5s ease;
            pointer-events: none;
        }

        .link-tile:hover::before {
            left: 130%;
        }

        .link-tile:hover {
            transform: translateY(-3px) scale(1.005);
            border-color:
                rgba(37, 99, 235, 0.2)
                rgba(37, 99, 235, 0.12)
                rgba(255, 255, 255, 0.35)
                rgba(255, 255, 255, 0.4);
            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.16) 0%,
                    rgba(255, 255, 255, 0.05) 50%,
                    rgba(255, 255, 255, 0.1) 100%
                );
            box-shadow:
                0 14px 40px -12px rgba(37, 99, 235, 0.1),
                0 0 0 3px rgba(37, 99, 235, 0.06),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.75),
                inset 1px 1px 0 0 rgba(255, 255, 255, 0.35),
                inset 0 0 30px -8px rgba(255, 255, 255, 0.14);
        }

        .link-tile:active {
            transform: translateY(-1px) scale(0.99);
            transition-duration: 0.08s;
        }

        .link-tile:focus-visible {
            outline: 3.75px solid var(--accent);
            outline-offset: 3px;
        }

        .link-tile:nth-child(1) { animation: cardIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both; }
        .link-tile:nth-child(2) { animation: cardIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.36s both; }

        .link-tile-icon {
            font-size: 1.6rem;
            line-height: 1;
            flex-shrink: 0;
            filter: drop-shadow(0 1px 4px rgba(37, 99, 235, 0.1));
            transition: transform 0.25s ease;
        }

        .link-tile:hover .link-tile-icon {
            transform: scale(1.12);
        }

        .link-tile-text {
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .link-tile-desc {
            font-size: 0.72rem;
            font-weight: 400;
            color: var(--fg-muted);
            margin-top: 0.1rem;
        }

        .footer-actions {
            display: flex;
            align-items: center;
            margin-top: 0.5rem;
        }

        .link-ghost {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--fg-muted);
            text-decoration: none;
            padding: 0.6rem 1.2rem;
            border-radius: var(--radius-sm);
            border: 1.5px solid transparent;
            background: transparent;
            transition:
                color 0.2s ease,
                background 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .link-ghost:hover {
            color: var(--accent);
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.35);
            box-shadow:
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.5),
                0 3px 18px -6px rgba(37, 99, 235, 0.1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .link-ghost:active {
            background: rgba(255, 255, 255, 0.3);
        }

        .link-ghost:focus-visible {
            outline: 3.75px solid var(--accent);
            outline-offset: 3px;
        }

        .link-ghost.back-link:hover {
            color: var(--fg);
        }

        .link-logout {
            color: rgba(160, 55, 55, 0.65);
        }

        .link-logout:hover {
            color: #b53c3c;
            background: rgba(180, 60, 60, 0.06);
            border-color: rgba(180, 60, 60, 0.1);
            box-shadow:
                inset 0 1.5px 0 0 rgba(255, 255, 255, 0.3),
                0 3px 18px -6px rgba(180, 60, 60, 0.08);
        }

        .link-logout:active {
            background: rgba(180, 60, 60, 0.1);
        }

        @@media (max-width: 520px) {
            body {
                padding: 2rem 1rem;
            }
            .dash-header {
                gap: 0.8rem;
            }
            .dash-header-icon {
                font-size: 2rem;
            }
            .dash-header h2 {
                font-size: 1.5rem;
            }
            .stats-row {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            .stat-card {
                padding: 1.2rem 1rem;
            }
            .stat-icon {
                font-size: 1.4rem;
            }
            .stat-value {
                font-size: 1.3rem;
            }
            .link-grid {
                grid-template-columns: 1fr;
                gap: 0.9rem;
            }
            .link-tile {
                padding: 1rem 1.2rem;
                gap: 0.8rem;
            }
            .link-tile-icon {
                font-size: 1.3rem;
            }
            .link-tile-text {
                font-size: 0.92rem;
            }
            .link-tile-desc {
                display: none;
            }
            .link-ghost {
                font-size: 0.9rem;
                padding: 0.5rem 1rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <div class="dash-content">

     
        <div class="dash-header">
            <span class="dash-header-icon" aria-hidden="true">&#127891;</span>
            <div>
                <h2>Institute Dashboard</h2>
                <p class="dash-header-sub">Overview of your tuition centre</p>
            </div>
        </div>


        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon" aria-hidden="true">&#128101;</div>
                <div class="stat-label">Total Students</div>
                <div class="stat-value">@ViewBag.TotalStudents</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" aria-hidden="true">&#9989;</div>
                <div class="stat-label">Active Students</div>
                <div class="stat-value">@ViewBag.ActiveStudents</div>
            </div>
        </div>

        <div class="divider"></div>


        <p class="section-label">Operations</p>
        <div class="link-grid">
            <a href="/Students" class="link-tile">
                <span class="link-tile-icon" aria-hidden="true">&#128221;</span>
                <div>
                    <div class="link-tile-text">Manage Students</div>
                    <div class="link-tile-desc">Add, edit or remove students</div>
                </div>
            </a>
            <a href="/Institute/ViewAttendanceRecords" class="link-tile">
                <span class="link-tile-icon" aria-hidden="true">&#128196;</span>
                <div>
                    <div class="link-tile-text">Attendance Records</div>
                    <div class="link-tile-desc">View all past attendance</div>
                </div>
            </a>
        </div>

        <div class="divider-sm"></div>

        <div class="footer-actions">
            @if (Context.Session.GetString("Role") == "Owner/Admin")
            {
                <a href="/Home/SelectModule" class="link-ghost back-link">&#8592; Back to Modules</a>
            }
            else
            {
                <a href="/Account/Logout" class="link-ghost link-logout">Logout</a>
            }
        </div>
    </div>

</body>
</html>