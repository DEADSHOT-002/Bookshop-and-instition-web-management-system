@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #eaf0f7;
            --fg: #1a2a3a;
            --fg-muted: #5e7a92;
            --accent: #2563eb;
            --accent-hover: #3b82f6;
            --accent-soft: rgba(37, 99, 235, 0.08);
            --accent-glow: rgba(37, 99, 235, 0.15);
            --glass-bg: rgba(255, 255, 255, 0.32);
            --glass-bg-strong: rgba(255, 255, 255, 0.48);
            --glass-border: rgba(255, 255, 255, 0.5);
            --glass-border-inner: rgba(255, 255, 255, 0.7);
            --glass-highlight: rgba(255, 255, 255, 0.7);
            --input-bg: rgba(255, 255, 255, 0.35);
            --input-border: rgba(148, 180, 210, 0.3);
            --input-focus-border: rgba(37, 99, 235, 0.5);
            --error: #dc2626;
            --error-bg: rgba(220, 38, 38, 0.06);
            --error-border: rgba(220, 38, 38, 0.12);
            --radius: 20px;
            --radius-sm: 12px;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        
        .blob {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }

        .blob-1 {
            width: 800px; height: 800px;
            background: radial-gradient(circle, rgba(37,99,235,0.35), transparent 65%);
            filter: blur(70px);
            top: -25%; right: -8%;
            animation: blobDrift1 14s ease-in-out infinite alternate;
        }
        .blob-2 {
            width: 700px; height: 700px;
            background: radial-gradient(circle, rgba(56,189,248,0.32), transparent 65%);
            filter: blur(70px);
            bottom: -20%; left: -10%;
            animation: blobDrift2 16s ease-in-out infinite alternate;
        }
        .blob-3 {
            width: 550px; height: 550px;
            background: radial-gradient(circle, rgba(99,102,241,0.28), transparent 65%);
            filter: blur(60px);
            top: 30%; left: 12%;
            animation: blobDrift3 12s ease-in-out infinite alternate;
        }
        .blob-4 {
            width: 450px; height: 450px;
            background: radial-gradient(circle, rgba(14,165,233,0.3), transparent 65%);
            filter: blur(60px);
            top: 5%; left: 50%;
            animation: blobDrift1 15s ease-in-out infinite alternate-reverse;
        }
        .blob-5 {
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(37,99,235,0.22), transparent 65%);
            filter: blur(80px);
            bottom: 0%; right: 10%;
            animation: blobDrift2 18s ease-in-out infinite alternate-reverse;
        }
        .blob-6 {
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(147,51,234,0.2), transparent 65%);
            filter: blur(50px);
            top: 55%; right: 25%;
            animation: blobDrift3 11s ease-in-out infinite alternate-reverse;
        }
        .blob-7 {
            width: 350px; height: 350px;
            background: radial-gradient(circle, rgba(59,130,246,0.25), transparent 65%);
            filter: blur(50px);
            top: 10%; left: 30%;
            animation: blobDrift1 10s ease-in-out infinite alternate;
        }

        @@keyframes blobDrift1 {
            0%   { transform: translate(0, 0) scale(1); }
            33%  { transform: translate(-60px, 50px) scale(1.08); }
            66%  { transform: translate(40px, -30px) scale(0.95); }
            100% { transform: translate(-20px, 60px) scale(1.05); }
        }
        @@keyframes blobDrift2 {
            0%   { transform: translate(0, 0) scale(1); }
            33%  { transform: translate(50px, -60px) scale(1.1); }
            66%  { transform: translate(-40px, 30px) scale(0.92); }
            100% { transform: translate(30px, -50px) scale(1.06); }
        }
        @@keyframes blobDrift3 {
            0%   { transform: translate(0, 0) scale(1); }
            50%  { transform: translate(-50px, -40px) scale(1.12); }
            100% { transform: translate(40px, 50px) scale(0.94); }
        }

   
        .dot-pattern {
            position: fixed; inset: 0;
            pointer-events: none; z-index: 0;
            opacity: 0.4;
            background-image: radial-gradient(circle, rgba(37,99,235,0.18) 2px, transparent 2px);
            background-size: 44px 44px;
            animation: dotPulse 5s ease-in-out infinite alternate;
        }
        @@keyframes dotPulse {
            0%   { opacity: 0.3; }
            100% { opacity: 0.55; }
        }

        .light-beam {
            position: fixed;
            pointer-events: none; z-index: 0;
            opacity: 0;
        }
        .light-beam-1 {
            top: -10%; left: -5%;
            width: 300px; height: 140vh;
            background: linear-gradient(160deg, rgba(37,99,235,0.1), transparent 60%);
            transform: rotate(-25deg);
            animation: beamSweep1 7s ease-in-out infinite;
        }
        .light-beam-2 {
            bottom: -10%; right: -5%;
            width: 250px; height: 140vh;
            background: linear-gradient(340deg, rgba(56,189,248,0.08), transparent 60%);
            transform: rotate(20deg);
            animation: beamSweep2 9s ease-in-out infinite;
        }
        .light-beam-3 {
            top: 20%; right: 15%;
            width: 200px; height: 120vh;
            background: linear-gradient(200deg, rgba(99,102,241,0.07), transparent 55%);
            transform: rotate(-40deg);
            animation: beamSweep3 6s ease-in-out infinite;
        }

        @@keyframes beamSweep1 {
            0%, 100% { opacity: 0; transform: rotate(-25deg) translateX(-100px); }
            50%      { opacity: 1; transform: rotate(-25deg) translateX(150px); }
        }
        @@keyframes beamSweep2 {
            0%, 100% { opacity: 0; transform: rotate(20deg) translateX(100px); }
            50%      { opacity: 1; transform: rotate(20deg) translateX(-120px); }
        }
        @@keyframes beamSweep3 {
            0%, 100% { opacity: 0; transform: rotate(-40deg) translateX(-80px); }
            40%      { opacity: 1; transform: rotate(-40deg) translateX(100px); }
            70%      { opacity: 0.5; transform: rotate(-40deg) translateX(60px); }
        }

        
        .pulse-ring {
            position: fixed;
            border-radius: 50%;
            pointer-events: none; z-index: 0;
        }
        .pulse-ring-1 {
            width: 500px; height: 500px;
            top: 15%; left: 8%;
            border: 2px solid rgba(37,99,235,0.1);
            animation: pulseRing 4s ease-in-out infinite;
        }
        .pulse-ring-2 {
            width: 350px; height: 350px;
            bottom: 10%; right: 12%;
            border: 2px solid rgba(56,189,248,0.12);
            animation: pulseRing 3.5s ease-in-out 1s infinite;
        }
        .pulse-ring-3 {
            width: 250px; height: 250px;
            top: 60%; left: 50%;
            border: 1.5px solid rgba(99,102,241,0.1);
            animation: pulseRing 4.5s ease-in-out 2s infinite;
        }

        @@keyframes pulseRing {
            0%, 100% { transform: scale(0.85); opacity: 0.3; }
            50%      { transform: scale(1.15); opacity: 0.85; }
        }

        .geo-shape {
            position: fixed;
            pointer-events: none; z-index: 0;
            opacity: 0.14;
        }
        .geo-1 {
            width: 80px; height: 80px;
            top: 12%; left: 15%;
            border: 3px solid rgba(37,99,235,0.5);
            border-radius: 16px;
            animation: geoSpin 10s linear infinite, geoFloat1 8s ease-in-out infinite;
        }
        .geo-2 {
            width: 60px; height: 60px;
            bottom: 18%; right: 18%;
            border: 3px solid rgba(56,189,248,0.5);
            border-radius: 50%;
            animation: geoSpin 12s linear reverse infinite, geoFloat2 9s ease-in-out infinite;
        }
        .geo-3 {
            width: 50px; height: 50px;
            top: 65%; left: 8%;
            border: 2px solid rgba(99,102,241,0.4);
            animation: geoSpin 9s linear infinite, geoFloat3 7s ease-in-out infinite;
        }
        .geo-4 {
            width: 70px; height: 70px;
            top: 8%; right: 22%;
            border: 2px solid rgba(14,165,233,0.4);
            border-radius: 20px;
            animation: geoSpin 11s linear reverse infinite, geoFloat1 10s ease-in-out 2s infinite;
        }
        .geo-5 {
            width: 40px; height: 40px;
            bottom: 30%; left: 35%;
            border: 2px solid rgba(37,99,235,0.35);
            border-radius: 8px;
            animation: geoSpin 8s linear infinite, geoFloat2 6s ease-in-out 3s infinite;
        }
        .geo-6 {
            width: 90px; height: 90px;
            bottom: 5%; left: 55%;
            border: 2px solid rgba(56,189,248,0.3);
            border-radius: 50%;
            animation: geoSpin 15s linear infinite, geoFloat3 11s ease-in-out 1s infinite;
        }

        @@keyframes geoSpin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }
        @@keyframes geoFloat1 {
            0%, 100% { translate: 0 0; }
            25%      { translate: 20px -15px; }
            50%      { translate: -10px 20px; }
            75%      { translate: 15px 10px; }
        }
        @@keyframes geoFloat2 {
            0%, 100% { translate: 0 0; }
            25%      { translate: -25px 15px; }
            50%      { translate: 15px -20px; }
            75%      { translate: -10px -10px; }
        }
        @@keyframes geoFloat3 {
            0%, 100% { translate: 0 0; }
            33%      { translate: 18px 18px; }
            66%      { translate: -22px -12px; }
        }

   
        .gradient-wave {
            position: fixed;
            bottom: -20%; left: -10%;
            width: 120%; height: 50%;
            pointer-events: none; z-index: 0;
            background: linear-gradient(0deg, rgba(37,99,235,0.1) 0%, rgba(56,189,248,0.06) 30%, transparent 70%);
            animation: waveMotion 6s ease-in-out infinite alternate;
        }
        @@keyframes waveMotion {
            0%   { transform: translateX(-3%) skewX(-2deg); }
            100% { transform: translateX(3%) skewX(2deg); }
        }
        .gradient-wave-top {
            position: fixed;
            top: -15%; right: -10%;
            width: 120%; height: 40%;
            pointer-events: none; z-index: 0;
            background: linear-gradient(180deg, rgba(99,102,241,0.08) 0%, rgba(37,99,235,0.05) 40%, transparent 70%);
            animation: waveMotionTop 7s ease-in-out infinite alternate;
        }
        @@keyframes waveMotionTop {
            0%   { transform: translateX(4%) skewX(1.5deg); }
            100% { transform: translateX(-4%) skewX(-1.5deg); }
        }

      
        .particle {
            position: fixed;
            border-radius: 50%;
            pointer-events: none; z-index: 0;
            opacity: 0;
            background: rgba(37,99,235,0.2);
            border: 1.5px solid rgba(255,255,255,0.5);
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
            animation: floatUp linear infinite;
        }
        @@keyframes floatUp {
            0%   { opacity: 0; transform: translateY(100vh) scale(0.4) rotate(0deg); }
            8%   { opacity: 0.75; }
            80%  { opacity: 0.3; }
            100% { opacity: 0; transform: translateY(-15vh) scale(1) rotate(200deg); }
        }

        .orbit-ring {
            position: fixed;
            top: 50%; left: 50%;
            width: 700px; height: 700px;
            margin-top: -350px; margin-left: -350px;
            border-radius: 50%;
            border: 1.5px solid rgba(37,99,235,0.1);
            pointer-events: none; z-index: 0;
            animation: orbitSpin 30s linear infinite;
        }
        .orbit-ring::before {
            content: '';
            position: absolute;
            top: -6px; left: 50%;
            width: 12px; height: 12px;
            border-radius: 50%;
            background: rgba(37,99,235,0.4);
            box-shadow: 0 0 20px rgba(37,99,235,0.3), 0 0 40px rgba(37,99,235,0.1);
        }
        .orbit-ring-2 {
            width: 900px; height: 900px;
            margin-top: -450px; margin-left: -450px;
            border-color: rgba(56,189,248,0.08);
            animation-duration: 40s;
            animation-direction: reverse;
        }
        .orbit-ring-2::before {
            width: 9px; height: 9px;
            background: rgba(56,189,248,0.35);
            box-shadow: 0 0 16px rgba(56,189,248,0.25), 0 0 32px rgba(56,189,248,0.08);
        }
        .orbit-ring-3 {
            width: 1100px; height: 1100px;
            margin-top: -550px; margin-left: -550px;
            border-color: rgba(99,102,241,0.05);
            animation-duration: 50s;
        }
        .orbit-ring-3::before {
            width: 7px; height: 7px;
            background: rgba(99,102,241,0.3);
            box-shadow: 0 0 14px rgba(99,102,241,0.2);
        }
        @@keyframes orbitSpin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }


        .float-item {
            position: fixed;
            z-index: 0;
            pointer-events: none;
            opacity: 0.16;
            font-size: 2.8rem;
            color: var(--accent);
            filter: drop-shadow(0 0 10px rgba(37,99,235,0.18));
            animation: itemFloat 8s ease-in-out infinite;
        }
        .float-item.large {
            font-size: 4rem;
            opacity: 0.12;
        }
        .float-item.small {
            font-size: 2rem;
            opacity: 0.2;
        }

        .fi-1  { top: 8%;  left: 6%;  animation-delay: -1s;  animation-duration: 9s;  }
        .fi-2  { top: 72%; left: 4%;  animation-delay: -3s;  animation-duration: 10s; }
        .fi-3  { top: 15%; right: 7%; animation-delay: -5s;  animation-duration: 8s;  }
        .fi-4  { top: 78%; right: 9%; animation-delay: -2s;  animation-duration: 11s; }
        .fi-5  { top: 42%; left: 2%;  animation-delay: -7s;  animation-duration: 9.5s;}
        .fi-6  { top: 5%;  right: 20%;animation-delay: -4s;  animation-duration: 7.5s;}
        .fi-7  { top: 88%; left: 20%; animation-delay: -6s;  animation-duration: 10.5s;}
        .fi-8  { top: 30%; right: 3%; animation-delay: -8s;  animation-duration: 8.5s;}
        .fi-9  { top: 55%; left: 25%;animation-delay: -1.5s;animation-duration: 12s; }
        .fi-10 { top: 20%; left: 40%;animation-delay: -4.5s;animation-duration: 7s;  }
        .fi-11 { top: 85%; right: 30%;animation-delay: -9s;  animation-duration: 9s;  }
        .fi-12 { top: 48%; right: 5%;animation-delay: -2.5s;animation-duration: 11.5s;}
        .fi-13 { top: 65%; left: 12%;animation-delay: -6.5s;animation-duration: 8s;  }
        .fi-14 { top: 10%; left: 60%;animation-delay: -3.5s;animation-duration: 10s; }
        .fi-15 { top: 38%; left: 70%;animation-delay: -7.5s;animation-duration: 7.5s;}
        .fi-16 { top: 75%; left: 45%;animation-delay: -0.5s;animation-duration: 9.5s;}

        @@keyframes itemFloat {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            20%      { transform: translateY(-18px) rotate(6deg); }
            40%      { transform: translateY(8px) rotate(-4deg); }
            60%      { transform: translateY(-12px) rotate(3deg); }
            80%      { transform: translateY(5px) rotate(-5deg); }
        }

     
        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 420px;
            margin: 1.5rem;
            padding: 3rem 2.5rem 2.5rem;
            background: var(--glass-bg);
            border: 1.5px solid var(--glass-border);
            border-radius: 24px;
            backdrop-filter: blur(40px) saturate(1.6) brightness(1.05);
            -webkit-backdrop-filter: blur(40px) saturate(1.6) brightness(1.05);
            box-shadow:
                0 8px 60px -12px rgba(37, 99, 235, 0.1),
                0 30px 80px -20px rgba(0, 0, 0, 0.06),
                inset 0 1px 0 0 var(--glass-border-inner),
                inset 0 -1px 0 0 rgba(255, 255, 255, 0.15),
                inset 1px 0 0 0 rgba(255, 255, 255, 0.1),
                inset -1px 0 0 0 rgba(255, 255, 255, 0.1);
            animation: cardIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(36px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            border-radius: 2px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.9),
                rgba(147, 197, 253, 0.5),
                rgba(255, 255, 255, 0.9),
                transparent
            );
            background-size: 200% 100%;
            animation: shimmer 4s ease-in-out infinite;
        }

        @@keyframes shimmer {
            0%, 100% { background-position: 200% 0; }
            50%      { background-position: -200% 0; }
        }

        .login-card::after {
            content: '';
            position: absolute;
            top: -40%;
            left: -20%;
            width: 140%;
            height: 80%;
            background: radial-gradient(ellipse, rgba(255, 255, 255, 0.18), transparent 60%);
            pointer-events: none;
            border-radius: 50%;
        }

        .login-card h2 {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--fg);
            margin-bottom: 0.3rem;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .subtitle {
            text-align: center;
            color: var(--fg-muted);
            font-size: 0.88rem;
            font-weight: 400;
            margin-bottom: 2rem;
            position: relative;
            z-index: 1;
        }

        .login-card p[style*="color:red"],
        .error-msg {
            color: var(--error) !important;
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            border-radius: var(--radius-sm);
            padding: 0.6rem 1rem;
            font-size: 0.84rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            text-align: center;
            position: relative;
            z-index: 1;
            animation: shakeIn 0.45s ease both;
        }

        @@keyframes shakeIn {
            0%   { opacity: 0; transform: translateX(-8px); }
            25%  { transform: translateX(6px); }
            50%  { transform: translateX(-4px); }
            75%  { transform: translateX(2px); }
            100% { opacity: 1; transform: translateX(0); }
        }

        .login-card form {
            position: relative;
            z-index: 1;
        }

        .form-group {
            margin-bottom: 1.3rem;
            animation: fieldIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .form-group:nth-child(1) { animation-delay: 0.1s; }
        .form-group:nth-child(2) { animation-delay: 0.18s; }

        @@keyframes fieldIn {
            from { opacity: 0; transform: translateY(12px); }
        }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--fg-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 0.45rem;
            transition: color 0.25s ease;
        }

        .form-group:focus-within label {
            color: var(--accent);
        }

        .form-group input {
            width: 100%;
            padding: 0.78rem 1rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.92rem;
            color: var(--fg);
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: var(--radius-sm);
            outline: none;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow:
                inset 0 1px 0 0 rgba(255, 255, 255, 0.5),
                inset 0 -1px 0 0 rgba(0, 0, 0, 0.02);
            transition:
                border-color 0.25s ease,
                background 0.25s ease,
                box-shadow 0.25s ease;
        }

        .form-group input::placeholder {
            color: rgba(90, 120, 150, 0.45);
        }

        .form-group input:hover {
            border-color: rgba(37, 99, 235, 0.25);
            background: rgba(255, 255, 255, 0.45);
        }

        .form-group input:focus {
            border-color: var(--input-focus-border);
            background: rgba(255, 255, 255, 0.52);
            box-shadow:
                inset 0 1px 0 0 rgba(255, 255, 255, 0.5),
                0 0 0 3px var(--accent-glow),
                0 0 20px -6px rgba(37, 99, 235, 0.1);
        }

        .btn-login {
            width: 100%;
            padding: 0.85rem 1.5rem;
            margin-top: 0.6rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            color: #fff;
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.75), rgba(56, 189, 248, 0.6));
            border: 1.5px solid rgba(255, 255, 255, 0.25);
            border-radius: var(--radius-sm);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow:
                0 4px 20px -4px rgba(37, 99, 235, 0.3),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.3),
                inset 0 -1px 0 0 rgba(0, 0, 0, 0.05);
            transition:
                transform 0.2s ease,
                box-shadow 0.3s ease,
                background 0.3s ease;
            animation: fieldIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.26s both;
        }

        .btn-login::before {
            content: '';
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: linear-gradient(
                105deg,
                transparent,
                rgba(255, 255, 255, 0.25),
                transparent
            );
            transition: left 0.5s ease;
            pointer-events: none;
        }

        .btn-login:hover::before {
            left: 125%;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.88), rgba(56, 189, 248, 0.72));
            box-shadow:
                0 8px 30px -4px rgba(37, 99, 235, 0.35),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.35),
                inset 0 -1px 0 0 rgba(0, 0, 0, 0.05);
        }

        .btn-login:active {
            transform: translateY(0) scale(0.985);
            box-shadow:
                0 2px 10px -2px rgba(37, 99, 235, 0.25),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.2);
        }

        .btn-login:focus-visible {
            outline: 2.5px solid var(--accent);
            outline-offset: 2px;
        }

        .btn-login .ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: scale(0);
            animation: rippleOut 0.6s ease-out forwards;
            pointer-events: none;
        }

        @@keyframes rippleOut {
            to { transform: scale(4); opacity: 0; }
        }

      
        @@media (max-width: 768px) {
            .orbit-ring, .orbit-ring-2, .orbit-ring-3,
            .geo-shape, .light-beam { display: none; }
            .float-item { font-size: 2rem; }
            .float-item.large { font-size: 2.8rem; }
        }

        @@media (max-width: 480px) {
            .login-card {
                padding: 2.25rem 1.5rem 2rem;
                border-radius: 18px;
            }
            .login-card h2 {
                font-size: 1.5rem;
            }
            .pulse-ring { display: none; }
            .float-item.small { display: none; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>


    <div class="blob blob-1" aria-hidden="true"></div>
    <div class="blob blob-2" aria-hidden="true"></div>
    <div class="blob blob-3" aria-hidden="true"></div>
    <div class="blob blob-4" aria-hidden="true"></div>
    <div class="blob blob-5" aria-hidden="true"></div>
    <div class="blob blob-6" aria-hidden="true"></div>
    <div class="blob blob-7" aria-hidden="true"></div>

  
    <div class="dot-pattern" aria-hidden="true"></div>

  
    <div class="light-beam light-beam-1" aria-hidden="true"></div>
    <div class="light-beam light-beam-2" aria-hidden="true"></div>
    <div class="light-beam light-beam-3" aria-hidden="true"></div>


    <div class="pulse-ring pulse-ring-1" aria-hidden="true"></div>
    <div class="pulse-ring pulse-ring-2" aria-hidden="true"></div>
    <div class="pulse-ring pulse-ring-3" aria-hidden="true"></div>


    <div class="geo-shape geo-1" aria-hidden="true"></div>
    <div class="geo-shape geo-2" aria-hidden="true"></div>
    <div class="geo-shape geo-3" aria-hidden="true"></div>
    <div class="geo-shape geo-4" aria-hidden="true"></div>
    <div class="geo-shape geo-5" aria-hidden="true"></div>
    <div class="geo-shape geo-6" aria-hidden="true"></div>

    <div class="gradient-wave" aria-hidden="true"></div>
    <div class="gradient-wave-top" aria-hidden="true"></div>

    <div class="orbit-ring" aria-hidden="true"></div>
    <div class="orbit-ring orbit-ring-2" aria-hidden="true"></div>
    <div class="orbit-ring orbit-ring-3" aria-hidden="true"></div>


    <div class="float-item fi-1" aria-hidden="true">&#128214;</div>
    <div class="float-item large fi-2" aria-hidden="true">&#128218;</div>
    <div class="float-item fi-3" aria-hidden="true">&#128209;</div>
    <div class="float-item fi-4" aria-hidden="true">&#128217;</div>
    <div class="float-item small fi-5" aria-hidden="true">&#128213;</div>
    <div class="float-item fi-6" aria-hidden="true">&#128216;</div>
    <div class="float-item small fi-7" aria-hidden="true">&#9999;&#65039;</div>
    <div class="float-item fi-8" aria-hidden="true">&#128221;</div>
    <div class="float-item small fi-9" aria-hidden="true">&#128208;</div>
    <div class="float-item fi-10" aria-hidden="true">&#128203;</div>
    <div class="float-item small fi-11" aria-hidden="true">&#128196;</div>
    <div class="float-item large fi-12" aria-hidden="true">&#128212;</div>
    <div class="float-item fi-13" aria-hidden="true">&#128197;</div>
    <div class="float-item small fi-14" aria-hidden="true">&#128200;</div>
    <div class="float-item fi-15" aria-hidden="true">&#128201;</div>
    <div class="float-item small fi-16" aria-hidden="true">&#128219;</div>

    <div class="login-card">
        <h2>Login</h2>
        <p class="subtitle">Enter your credentials to continue</p>

        @if (ViewBag.Error != null)
        {
            <p style="color:red">@ViewBag.Error</p>
        }

        <form method="post" novalidate>
            <div class="form-group">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" placeholder="Enter your username" autocomplete="username" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn-login" aria-label="Sign in">Login</button>
        </form>
    </div>

    <script>
  
        document.querySelector('.btn-login').addEventListener('click', function (e) {
            var ripple = document.createElement('span');
            ripple.classList.add('ripple');
            var rect = this.getBoundingClientRect();
            var size = Math.max(rect.width, rect.height);
            ripple.style.width = ripple.style.height = size + 'px';
            ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
            ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
            this.appendChild(ripple);
            ripple.addEventListener('animationend', function () { ripple.remove(); });
        });

        (function () {
            for (var i = 0; i < 24; i++) {
                var p = document.createElement('div');
                p.classList.add('particle');
                var s = 8 + Math.random() * 20;
                p.style.width = p.style.height = s + 'px';
                p.style.left = Math.random() * 100 + 'vw';
                p.style.animationDuration = (10 + Math.random() * 18) + 's';
                p.style.animationDelay = -(Math.random() * 25) + 's';
                document.body.appendChild(p);
            }
        })();
    </script>
</body>
</html>