@model List<BookshopTuitionSystem.Models.Order>

<h2>Sales Dashboard - Today</h2>

<hr />

<h3>Summary</h3>

<p><strong>Total Revenue:</strong> @ViewBag.TodayRevenue</p>
<p><strong>Total Orders:</strong> @ViewBag.TodayOrdersCount</p>
<p><strong>Items Sold:</strong> @ViewBag.TodayItemsSold</p>

<hr />

<h3>Today's Sales</h3>

@if (!Model.Any())
{
    <p>No sales today.</p>
}
else
{
    <table border="1" cellpadding="10">
        <tr>
            <th>Invoice</th>
            <th>Date</th>
            <th>Total</th>
        </tr>

        @foreach (var o in Model)
        {
            <tr>
                <td>@o.InvoiceNumber</td>
                <td>@o.OrderDate</td>
                <td>@o.GrandTotal</td>
            </tr>
        }
    </table>
}